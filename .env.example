ADDR=:25504
BITRIX_WEBHOOK_URL=https://<portal>.bitrix24.ru/rest/<user_id>/<webhook_key>/
BITRIX_APP_CLIENT_ID=   # Application ID (для portal app, optional)
BITRIX_APP_CLIENT_SECRET=   # Application key (для portal app, optional)
TASK_WORKERS=10
TASK_STRATEGY=bulk
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_WRITE_TIMEOUT_SECONDS=3600
HTTP_IDLE_TIMEOUT_SECONDS=120
HTTP_SHUTDOWN_TIMEOUT_SECONDS=20
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=6
SUPPORT_LINK_DEAL_FIELD=UF_CRM_
SUPPORT_MEASURE_VALUE_FIELD=UF_CRM_

# Безопасность API (/api/*)
API_ACCESS_TOKEN=

# Авторизация пользователей
AUTH_ENABLED=true
AUTH_DB_DSN=postgres://invest_db_user:1234@postgres:5432/bitrix_db?sslmode=disable
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=10080

# 2 фиксированных аккаунта (без регистрации)
AUTH_USER_1_LOGIN=
AUTH_USER_1_PASSWORD=
AUTH_USER_2_LOGIN=
AUTH_USER_2_PASSWORD=

# Параметры контейнера Postgres (для docker-compose)
AUTH_DB_NAME=bitrix_db
AUTH_DB_USER=invest_db_user
AUTH_DB_PASSWORD=1234
