ADDR=:25504

# Учетные данные приложения портала Битрикс24 (резервный вариант для одного портала)
BITRIX_APP_CLIENT_ID=app.xxxxxxxxxxxxxxxxx
BITRIX_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Многопортальный режим (опционально).
# Если установлен параметр PORTALS, приложение пытается разрешить учетные данные по домену портала из сеанса.
# Пример:
# PORTALS=invest45,portal2
# B24_INVEST45_DOMAIN=invest45.bitrix24.ru
# B24_INVEST45_CLIENT_ID=local.xxx
# B24_INVEST45_CLIENT_SECRET=xxx
# B24_PORTAL2_DOMAIN=another.bitrix24.ru
# B24_PORTAL2_CLIENT_ID=local.yyy
# B24_PORTAL2_CLIENT_SECRET=yyy

PORTALS=portal1,portal2

B24_INVEST45_DOMAIN=portal1.bitrix24.ru
B24_INVEST45_CLIENT_ID=local.xxx
B24_INVEST45_CLIENT_SECRET=xxx

B24_PORTAL2_DOMAIN=portal2.bitrix24.ru
B24_PORTAL2_CLIENT_ID=local.yyy
B24_PORTAL2_CLIENT_SECRET=yyy

TASK_WORKERS=14
TASK_STRATEGY=bulk
DELETE_LAST_EXPORT_AFTER_DOWNLOAD=false
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_WRITE_TIMEOUT_SECONDS=3600
HTTP_IDLE_TIMEOUT_SECONDS=120
HTTP_SHUTDOWN_TIMEOUT_SECONDS=20
RATE_LIMIT_EXPORT_PER_MINUTE=6

# Поля Битрикс для мер поддержки
SUPPORT_LINK_DEAL_FIELD=UF_CRM_1770268007
SUPPORT_MEASURE_VALUE_FIELD=UF_CRM_1744702884242

# Опциональный системный токен для прямых /api вызовов (curl/техпроверки)
API_ACCESS_TOKEN=
